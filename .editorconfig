root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 140
ij_java_method_parameters_wrap = off
ij_java_method_call_arguments_wrap = off

[*.{xml,yml,yaml}]
indent_style = space
indent_size = 2
